<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#FF121212"
    android:orientation="vertical"
    android:paddingStart="10dp"
    android:paddingTop="8dp"
    android:paddingEnd="10dp"
    android:paddingBottom="10dp">

    <TextView
        android:id="@+id/ime_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:singleLine="true"
        android:text="@string/ime_status_no_server"
        android:textColor="#FFAAAAAA"
        android:textSize="12sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:baselineAligned="false"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <Button
            android:id="@+id/ime_mic"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:backgroundTint="#FF2E7D32"
            android:text="@string/ime_hold_to_talk"
            android:textAllCaps="false"
            android:textColor="#FFFFFFFF"
            android:textSize="14sp" />

        <Button
            android:id="@+id/ime_cancel"
            android:layout_width="wrap_content"
            android:layout_height="56dp"
            android:layout_marginStart="6dp"
            android:backgroundTint="#FFC62828"
            android:text="@string/ime_cancel"
            android:textAllCaps="false"
            android:textColor="#FFFFFFFF"
            android:textSize="12sp"
            android:visibility="gone" />

        <Button
            android:id="@+id/ime_switch"
            android:layout_width="wrap_content"
            android:layout_height="56dp"
            android:layout_marginStart="6dp"
            android:backgroundTint="#FF333333"
            android:contentDescription="@string/ime_switch_keyboard"
            android:text="@string/ime_switch_keyboard"
            android:textAllCaps="false"
            android:textColor="#FFDDDDDD"
            android:textSize="12sp" />

        <Button
            android:id="@+id/ime_settings"
            android:layout_width="wrap_content"
            android:layout_height="56dp"
            android:layout_marginStart="6dp"
            android:backgroundTint="#FF333333"
            android:contentDescription="@string/ime_settings_description"
            android:minWidth="48dp"
            android:text="@string/ime_settings"
            android:textColor="#FFDDDDDD"
            android:textSize="18sp" />
    </LinearLayout>

</LinearLayout>
